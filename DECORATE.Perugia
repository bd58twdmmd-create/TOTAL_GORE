// Motorcycle
Actor ignition: Inventory //Code added for bike delay -Vostyok
{
inventory.maxamount 1
}
Actor Throttle: Inventory //Code added for drive sound -Vostyok
{
inventory.maxamount 1
}
Actor Revup : Inventory //Code added for different speeds -Vostyok
{
inventory.maxamount 1
}
Actor Revdown : Inventory
{
inventory.maxamount 1
}
Actor LeftTurn : Inventory
{
inventory.maxamount 1
}
Actor RightTurn : Inventory
{
inventory.maxamount 1
}
ACTOR speedo : Inventory
{
	Inventory.MaxAmount 99
}
Actor turnrateleft : Inventory
{
    inventory.maxamount 6
}
Actor turnrateright : Inventory
{
    inventory.maxamount 6
}

ACTOR Motorcycle : CustomInventory 7000
{
    scale 0.8
	Radius 40
    Height 30
	inventory.pickupflash ""
	Inventory.PickupMessage "Time to roll out!"
	States
	{
	Spawn:
		BIKE A -1
		Stop
	Pickup:
		TNT1 A 0 //ACS_ExecuteAlways (900,0)
		Stop
	}
}
ACTOR MotorcyclePlayerMorph : PowerupGiver 15814 //new powerup for ease of use - Vostyok
{
 scale 0.8
 Powerup.Type PowerChopperPlayer
 Powerup.Duration 0x7FFFFFFF
 Inventory.MaxAmount 0
 inventory.pickupflash ""
 +INVENTORY.AUTOACTIVATE
 Inventory.PickupSound "bike/Start"
 Inventory.PickupMessage "Time to roll out!"
}

ACTOR PowerchopperPlayer : PowerMorph // ditto - Vostyok
{
 PowerMorph.PlayerClass "MotorcyclePlayer"
 PowerMorph.MorphStyle MRF_TRANSFERTRANSLATION
 PowerMorph.MorphFlash "NoFlashStart"
 PowerMorph.UnMorphFlash "NoFlashStop"
}
ACTOR NoFlashstart //oh this is SUCH a hack - Vostyok
{
 SeeSound "bike/start"
 RenderStyle None
 States
 {
 Spawn:
  TNT1 A 100
  Stop
 }
} 
ACTOR NoFlashstop // -Vostyok
{
 SeeSound "bike/stop"
 RenderStyle None
 States
 {
 Spawn:
  TNT1 A 100
  Stop
 }
} 
Actor Bikeslowcrash
{
  +NOBLOCKMAP
  +NOGRAVITY
  +ALLOWPARTICLES
  +RANDOMIZE
  +PUFFGETSOWNER
  RenderStyle Translucent
  Alpha 0.5
  VSpeed 1
  Mass 5
  attacksound "Bike/crash"
  States
  {
  Spawn:
    TNT1 A 0
    PIN2 C 2 A_TakeFromTarget("speedo", 3)
    // Intentional fall-through
  Melee:
    PIN2 DEFGH 1 a_explode(1,16)
    Stop
    Stop
  }
}
