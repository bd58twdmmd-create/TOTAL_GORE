// Removed Motospawner - OBSOLETE - Vostyok
ACTOR Motohandles : Weapon //no guns for you, yet -Vostyok
{
	Game Doom
  	Weapon.SelectionOrder 9000
	Weapon.YAdjust -30  
	weapon.kickback 500
	+INVENTORY.UNDROPPABLE
	States
  	{
  	Ready:
	    TNT1 A 0 A_JumpIfInventory("Leftturn", 1, "leftturn")
		TNT1 A 0 A_JumpIfInventory("rightturn", 1, "rightturn")
    	MOTH A 1 A_WeaponReady
		MOTH A 0 A_takeinventory("turnrateleft", 6)
		MOTH A 0 A_takeinventory("turnrateright", 6)
		MOTH A 0 A_SetRoll(0,SPF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("speedo",10, 1)
		goto ready
		TNT1 A 0
		goto crashcheck
	LeftTurn: 
	    TNT1 A 0 A_JumpIfInventory("turnrateleft",6, 9)
		TNT1 A 0 A_JumpIfInventory("turnrateleft",4, 6)
		TNT1 A 0 A_JumpIfInventory("turnrateleft",2, 3) 
		MOTH B 1 A_WeaponReady
		MOTH A 0 A_jump(256, 6) 
		MOTH C 1 A_WeaponReady
		MOTH A 0 A_jump(256, 4) 
		MOTH D 1 A_WeaponReady
		MOTH A 0 A_jump(256, 2) 
		MOTH E 1 A_WeaponReady
		TNT1 A 0 A_giveInventory("turnrateleft", 1)
		TNT1 A 0 A_takeInventory("turnrateright", 6)
	    TNT1 A 0 A_JumpIfInventory("speedo",1, 1)
		goto ready
		TNT1 AA 000 A_SetAngle(0.6 + angle)
		MOTH A 0 A_SetRoll(-8,SPF_INTERPOLATE)
		goto crashcheck
	RightTurn:
		TNT1 A 0 A_JumpIfInventory("turnrateright",6, 9)
		TNT1 A 0 A_JumpIfInventory("turnrateright",4, 6)
		TNT1 A 0 A_JumpIfInventory("turnrateright",2, 3) 
		MOTH F 1 A_WeaponReady
		MOTH A 0 A_jump(256, 6) 
		MOTH G 1 A_WeaponReady
		MOTH A 0 A_jump(256, 4) 
		MOTH H 1 A_WeaponReady
		MOTH A 0 A_jump(256, 2) 
		MOTH I 1 A_WeaponReady
		TNT1 A 0 A_giveInventory("turnrateright", 1)
		TNT1 A 0 A_takeInventory("turnrateleft", 6)
		TNT1 A 0 A_JumpIfInventory("speedo",1, 1)
		goto ready
		TNT1 AA 000 A_SetAngle(-0.6 + angle)
		MOTH A 0 A_SetRoll(8,SPF_INTERPOLATE)
		goto crashcheck
	CrashCheck:
	    MOTH A 0 A_JumpIfInventory("speedo",50, 9)
		TNT1 A 0 A_JumpIfInventory("speedo",25, 4)
		TNT1 A 0 A_FireBullets(-45,-32,-1,5,"Bikeslowglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(0,-32,-1,5,"Bikeslowcrash",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(45,-32,-1,5,"Bikeslowglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
		goto ready
		TNT1 A 0 A_FireBullets(-45,-32,-1,10,"Bikemediumglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(0,-32,-1,10,"Bikemediumcrash",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(45,-32,-1,10,"Bikemediumglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
		goto ready
		TNT1 A 0 A_FireBullets(-45,-32,-1,40,"Bikefastglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(0,-32,-1,40,"Bikefastcrash",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
	    TNT1 A 0 A_FireBullets(45,-32,-1,40,"Bikefastglance",FBF_EXPLICITANGLE|FBF_NORANDOM,60)
		goto ready
  	Deselect:
    	MOTH A 1 A_Lower
    	Loop
  	Select:
    	TNT1 A 0 A_Raise
    	Loop
  	Fire:
		Goto Ready
	Spawn:
    	TNT1 A -1
    	Stop
  	}
}

ACTOR MotorcyclePlayer : playerpawn
{
    scale 0.8
  	Health 100
  	ReactionTime 0
  	PainChance 255
	player.hexenarmor 50,0,0,0,0
  	Radius 28
  	Height 56
	Player.AttackZOffset -16
  	Speed 1
  	Gravity 0.2 //for jump n stuff - Vostyok
	Mass 200
  	Player.JumpZ 0
  	Player.Viewheight 32
  	Player.ForwardMove 1.5, 2.0
  	Player.SideMove 0, 0
  	Player.SoundClass "Motorcycle"
  	Player.DisplayName "Motorcycle"
  	Player.MorphWeapon "Motohandles"
	Player.ColorRange 112, 127
  	-PICKUP
  	+NOSKIN
	States
  	{
  	Spawn:
	    PBIK A 2
		TNT1 A 0 A_checkfloor(1)
		goto drift
		TNT1 A 0 A_JumpIfInventory("ignition", 1, 1)
		goto ignition
	    TNT1 A 0 A_JumpIfInventory("revdown", 1, "decelerate")
		TNT1 A 0 A_JumpIfInventory("revup", 1, "Accelerate")
		PBIK A 0 A_StartSound("bike/idle",CHAN_VOICE,CHANF_DEFAULT,0.8,1)
    	PBIK A 2 A_takeInventory("throttle", 1)
		TNT1 A 0 A_TakeInventory("speedo", 3)
		TNT1 A 0 A_JumpIfInventory("speedo", 90, "Accelerate8")
		TNT1 A 0 A_JumpIfInventory("speedo", 80, "Accelerate7")
		TNT1 A 0 A_JumpIfInventory("speedo", 60, "Accelerate6")
		TNT1 A 0 A_JumpIfInventory("speedo", 40, "Accelerate5")
		TNT1 A 0 A_JumpIfInventory("speedo", 30, "Accelerate4")
		TNT1 A 0 A_JumpIfInventory("speedo", 20, "Accelerate3")
		TNT1 A 0 A_JumpIfInventory("speedo", 10, "Accelerate2")
		PBIK A 2
		TNT1 A 0 A_TakeInventory("speedo", 1)
		TNT1 A 0 A_JumpIfInventory("speedo", 90, "Accelerate8")
		TNT1 A 0 A_JumpIfInventory("speedo", 80, "Accelerate7")
		TNT1 A 0 A_JumpIfInventory("speedo", 60, "Accelerate6")
		TNT1 A 0 A_JumpIfInventory("speedo", 40, "Accelerate5")
		TNT1 A 0 A_JumpIfInventory("speedo", 30, "Accelerate4")
		TNT1 A 0 A_JumpIfInventory("speedo", 20, "Accelerate3")
		TNT1 A 0 A_JumpIfInventory("speedo", 10, "Accelerate2")
    	loop
	Ignition:
	    PBIK A 35
		PBIK A 0 A_StartSound("bike/idle",CHAN_VOICE,CHANF_DEFAULT,0.8,1)
		PBIK A 0 A_giveInventory("ignition", 1)
	    goto spawn
    Accelerate:
	    TNT1 A 0
		TNT1 A 0 a_stopsound(CHAN_WEAPON)
		TNT1 A 0 A_jumpifinventory("throttle", 1, 1)
		TNT1 A 0 A_StartSound("bike/revup", 2, 1, 1)
		TNT1 A 0 A_GiveInventory("throttle", 1)
		TNT1 A 0 A_JumpIfInventory("speedo", 95, "Accelerate8")
		TNT1 A 0 A_JumpIfInventory("speedo", 75, "Accelerate7")
		TNT1 A 0 A_JumpIfInventory("speedo", 60, "Accelerate6")
		TNT1 A 0 A_JumpIfInventory("speedo", 45, "Accelerate5")
		TNT1 A 0 A_JumpIfInventory("speedo", 30, "Accelerate4")
		TNT1 A 0 A_JumpIfInventory("speedo", 20, "Accelerate3")
		TNT1 A 0 A_JumpIfInventory("speedo", 10, "Accelerate2")
		PBIK B 1 A_Recoil(-1)
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		PBIK A 0 a_stopsound(CHAN_WEAPON)
		Goto spawn
	decelerate:
		TNT1 A 0 A_takeInventory("Revdown", 1)
		TNT1 A 0 A_TakeInventory("speedo", 2)
		TNT1 A 0 A_takeInventory("throttle", 1)
		TNT1 A 0 A_JumpIfInventory("speedo", 2, "Brake")
		PBIK A 0 A_Recoil(1)
		TNT1 A 0 a_stopsound(CHAN_WEAPON)
		Goto turncheck2
	drift:
	    TNT1 A 0 A_TakeInventory("revup", 1)
		PBIK A 0 A_Recoil(-1)
		TNT1 A 0 a_stopsound(CHAN_WEAPON)
		Goto spawn
	brake:
	    TNT1 A 0 A_TakeInventory("speedo", 3)
		TNT1 A 0 A_TakeInventory("revup", 1)
		TNT1 A 0 A_takeInventory("throttle", 1)
		PBIK A 0 A_Recoil(-1)
		PBIK A 0 A_spawnitemex("DustCloud",0,5,8,5)
	    TNT1 A 0 A_StartSound("bike/skid",CHAN_WEAPON,1,1)
		goto spawn
	Accelerate2:
	    PBIK B 1 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInventory("speedo", 20, "Accelerate3")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	Accelerate3:
	    PBIK B 1 A_Recoil(-2)
		TNT1 A 0 A_JumpIfInventory("speedo", 30, "Accelerate4")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn	
	Accelerate4:
	    PBIK B 1 A_Recoil(-3)
		TNT1 A 0 A_JumpIfInventory("speedo", 40, "Accelerate5")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	Accelerate5:
	    PBIK B 1 A_Recoil(-4)
		TNT1 A 0 A_JumpIfInventory("speedo", 60, "Accelerate6")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	Accelerate6:
	    PBIK B 1 A_Recoil(-5)
		TNT1 A 0 A_JumpIfInventory("speedo", 80, "Accelerate7")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	Accelerate7:
	    PBIK B 1 A_Recoil(-6)
		TNT1 A 0 A_JumpIfInventory("speedo", 90, "Accelerate8")
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	Accelerate8:
	    PBIK B 1 A_Recoil(-7)
		TNT1 A 0 A_GiveInventory("speedo", 2)
		TNT1 A 0 A_TakeInventory("revup", 1)
		Goto spawn
	TurnCheck2:
	    TNT1 A 0 A_JumpIfInventory("LeftTurn", 1, "leftturn2")
		TNT1 A 0 A_JumpIfInventory("rightturn", 1, "rightturn2")
		goto spawn
	RightTurn2:
	    TNT1 AA 000 A_SetAngle(1 + angle)
		TNT1 A 0 A_TakeInventory("rightturn", 1)
		TNT1 A 0 A_TakeInventory("leftturn",1)
		TNT1 A 000 A_SetAngle(1 + angle)
		goto spawn
	LeftTurn2:
	    TNT1 AA 000 A_SetAngle(-1 + angle)
		TNT1 A 0 A_TakeInventory("rightturn", 1)
		TNT1 A 0 A_TakeInventory("leftturn",1)
		TNT1 A 000 A_SetAngle(-1 + angle)
		goto spawn
  	Pain:
    	PBIK A 4 
    	PBIK A 4 A_Pain
    	Goto Spawn
  	Death:
	    PKIK A 0 a_stopsound(CHAN_VOICE)
		PKIK A 0 a_stopsound(CHAN_WEAPON)
		PKIK C 1 A_StartSound("weapons/rocklx",CHAN_WEAPON)
		PBIK C 1 A_StartSound ("pl_xdeath",CHAN_VOICE)
    	PBIK C 4 bright A_Scream
    	PBIK D 6 bright 
    	PBIK E 6 bright
    	PBIK F 6 A_NoBlocking
    	PBIK G -1
    	Stop
  	}
}

ACTOR DustCloud
{
    +RANDOMIZE
	+NOBLOCKMAP
	+FLOORCLIP
	+FORCEXYBILLBOARD
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+MISSILE
	Speed 1
	RenderStyle Add
	Alpha		0.3
	+CLIENTSIDEONLY
	Radius		0
	Height		0
	Scale		0.6
	States
	{
	Spawn:
		TNT1 A 1
		DUST ABCDEFGH 6 A_FadeOut(0.1)
		Stop
	}
}

ACTOR VehicleMotorcycle: SwitchingDecoration 356
{
  scale 0.8
  Radius 10
  Height 25
  Activation THINGSPEC_Activate
  +USESPECIAL
  States
  {
  Spawn:
    BIKE A 10
    Loop
  Active:
    BIKE A 0 A_SpawnItemEx ("Motorcycle", 0, 0, 0, 0 ,0 ,0 , 0)
    stop
  }
}
//Motorcycle code ends

