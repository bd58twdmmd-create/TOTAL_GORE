Actor FUMO
{
	Radius 12
	Height 12
	+NOINTERACTION
	Renderstyle Translucent
	Alpha 0.6
	States
	{
	Spawn:
		SMK8 I 1
	
	Live:
		TNT1 A 20
		TNT1 A 0 A_SpawnProjectile ("FUMOPARTICLE2", 0, 0, random (0, 360), 2, random (80, 90))
		Loop
	}
}

