Actor segacircolare : SwitchableDecoration
{
	Scale 0.3

	+NOGRAVITY
	+NOCLIP
	ACTIVATION THINGSPEC_Switch

	States
	{
		Spawn:
			TNT1 A 0
			1000 A -1
			Stop

		Active:
			TNT1 A 0 A_StartSound("segac", CHAN_AUTO, CHANF_DEFAULT, 1.0, 0.8)
			//TNT1 A 0 A_StartSound("segac",CHAN_AUTO,1.0,FALSE,0.8)
			1000 BCDEFGHIJKLMN 2 A_SpawnProjectile("asciaattack",0,0,0,0)
			1000 OPQRSTU 2 A_SpawnItemEx("XDeath1",20,0,90)
			1000 UTSRQPONMLKJIHGFEDCB 2
			//1001 ABCDE 2 A_SPAWNITEMEX("XDeath1",20,0,100)
			//1001 FGHIJK 2 A_SPAWNITEMEX("XDeath1",20,0,120)
			//1001 LMNOPQRS 2
			//1001 SRQPONML 2
			//1001 KJIHGF 2
			//1001 T -1
			Loop
	}
}

