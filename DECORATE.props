ACTOR cazzetto
{
  //$Category industrial
  Height 220
  radius 70
  speed 3
  health 5000
  monster
  //speed 0
  //scale 0.25
  +floatbob
  //+FRIENDLY
  +SOLID
  //+BUDDHA
  meleerange 150
  +FRIGHTENED
  activesound "cazzetto"
  
  States
  {
  Spawn:
    TERA A 0
    TERA A 10 A_look
	Loop
	
	see:
	TERA A 0
	TERA A 10 A_Chase
	TERA A 10 A_FaceTarget
	loop
	
	melee:
	//TNT1 A 0 
	TERA A 5 //A_SpawnProjectile("asciaattack",90,0,0,0)
	goto see
	
	Death:
  TNT1 A 0 ACS_ExecuteAlways (31,0) 
  TNT1 A 0 A_SpawnProjectile ("BeefExploder", 62, 0, random (0, 360), 2, random (0, 160))
  TNT1 A 0 A_SPAWNITEMEX("GIBSPAWNERGOREZ",0,0,0,RANDOM(0,0),RANDOM(0,0),0)
  
	   TNT1 A 0 A_SpawnProjectile ("cuore", 84, 0, random (0, 360), 2, random (0, 160))
	   TNT1 A 0 A_SpawnItemEx("dito2",0,0,2,frandom(8.0,16.0),0,frandom(8.0,16.0),frandom(135.0,225.0),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	   TNT1 A 0 A_SpawnItemEx("budella3",0,0,2,frandom(8.0,16.0),0,frandom(8.0,16.0),frandom(135.0,225.0),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	   TNT1 A 0 A_SpawnItemEx("budella4",0,0,2,frandom(8.0,16.0),0,frandom(8.0,16.0),frandom(135.0,225.0),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	   TNT1 A 0 A_SpawnProjectile ("budella", 84, 0, random (0, 360), 2, random (0, 160))
	   TNT1 A 0 A_SpawnProjectile ("budella2", 84, 0, random (0, 360), 2, random (0, 160))
