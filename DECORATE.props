Actor striscione_arena
{
	Radius 30
	Height 30
	Mass 10000
	//scale 0.25
	-SOLID
	

	States
	{
		Spawn:
			SACO A 0 //senza questo non si vede nel builder
			TNT1 A 0 A_Jump(256, "conad", "gesuofica", "coseincristo","baffo","egorex","mediaset","retesole","todis", "grezzodue2", "nazitutto")
		
		conad:
			SACO ABCDEFGHIJKLMNOPQ 3 BRIGHT
			Loop

		gesuofica:
			SAGF ABCDEFGHIJKLMNOPQ 3 BRIGHT
			Loop

		coseincristo:
			SACC ABCDEFGHIJKLMNOPQ 3 BRIGHT
			Loop
			
			baffo:
			SABF ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop
			
			egorex:
			SAEG ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop
			
						mediaset:
			SAME ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop
			
						retesole:
			SARE ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop
			
									todis:
			SATO ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop

		grezzodue2:
			SAG2 ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop

		nazitutto:
			SANT ABCDEFGHIJKLMNOPQ 3 BRIGHT
			loop
			
	}
}

Actor striscione_arena_pubblico
{
	Radius 30
	Height 30
	Mass 10000
	//scale 0.25
	-SOLID
	+NOGRAVITY
	

	States
	{
		Spawn:
			SAP1 A 0 //senza questo non si vede nel builder
			TNT1 A 0 A_Jump(256, "striscione_gesu", "dicanio", "giochipenosi", "grezzodue2", "iconafabio", "nazilgbt", "laficaeladroga") //,"sialrazz")
		
		striscione_gesu:
			TNT1 A 0 A_SetScale(2.0)
			SAP1 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		dicanio:
			TNT1 A 0 A_SetScale(2.0, 1.5)
			SAP3 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		giochipenosi:
			TNT1 A 0 A_SetScale(2.0)
			SAP4 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		grezzodue2:
			TNT1 A 0 A_SetScale(2.5, 1.5)
			SAP5 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		iconafabio:
			TNT1 A 0 A_SetScale(2.0)
			SAP6 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		nazilgbt:
			TNT1 A 0 A_SetScale(2.1, 1.6)
			SAP7 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		/*sialrazz:
			TNT1 A 0 A_SetScale(4.5, 1.2)
			SAP8 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop
			*/

		striscionegesu:
			TNT1 A 0 A_SetScale(2.0)
			SAP9 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop

		laficaeladroga:
			TNT1 A 0 A_SetScale(4.5, 1.5)
			SP10 ABCDEFGHIJKLMNOP Random(1, 3) BRIGHT
			Loop
	}
}

