		KSPH A 1 A_SetScale(.33,.40)
		KSPH A 1 A_SetScale(.34,.41)
		KSPH A 1 A_SetScale(.35,.42)
		KSPH A 1 A_SetScale(.36,.43)
		KSPH A 1 A_SetScale(.37,.44)
		KSPH A 1 A_SetScale(.38,.45)
		KSPH A 1 A_SetScale(.39,.46)
		KSPH A 0 A_fadeout(0.08)
		KSPH A 2 A_SetScale(.40,.47)
		KSPH A 0 A_fadeout(0.08)
		KSPH A 2 A_SetScale(.41,.48)
		KSPH A 0 A_fadeout(0.08)
