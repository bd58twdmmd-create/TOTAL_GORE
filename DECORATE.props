ACTOR EYEBOSS 
{
Health 10000
  Speed 0
  Height 100
  radius 50
  PainChance 0
  Mass 99999999
  Monster
  scale 40
  +SOLID
  +NOGRAVITY
  +DONTFALL
  +FLOATBOB
  +
  
  //ActiveSound "EYESFX"
  //DeathSound "MASKAGGR"
  //AttackSound "DEATHM"
  
  States
  {
  
  Spawn:
    
	TERA B 0 
    TERA B 1 A_Look
	
    goto see
	
	see:
	
	TNT1 A 0 A_FaceTarget
	TERA A 1 A_Chase
	
	loop
	

	
	
	Death:
	TNT1 A 0 ACS_NamedExecute ("luci_occhi1",0)
	TNT1 A 0 A_SPAWNITEMEX("GIBSPAWNER",0,0,0,RANDOM(0,0),RANDOM(0,0),0)
    Stop
	
 }
}

