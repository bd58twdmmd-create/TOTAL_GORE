Actor LTPLavaBase : LTPCoreSplashBase
{

	Alpha 1.0
	renderstyle AddShaded // treats black on the texture as transparent and white as full opacity
	stencilcolor "fd7900"//HEX color found in gimp color selector in ther HTML notation box.
	States
	{
	Spawn:
		HSPH A 1 Bright
		TNT1 A 0 A_JumpIf(CallACS("LTPSmallSplash")==0, "Cancel")
		HSPH A 0 A_spawnitemex ("LTPLavaSmokeSmall",0,0,8,0,0,1)
		HSPH BCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
		Stop
	Cancel:
		TNT1 A 0
		Stop
	}
}

Actor LTPLavaSmoke : LTPCoreSplashBase
{

	Alpha 0.0
	renderstyle Shaded // treats black on the texture as transparent and white as full opacity
	stencilcolor "0e0e0e"//HEX color found in gimp color selector in ther HTML notation box.
	-FORCEYBILLBOARD
	+FORCEXYBILLBOARD
	+LOWGRAVITY
	+ROLLSPRITE
	+ROLLCENTER
	States
	{
	Spawn:
		LSMK A 1 
		LSMK A 0 A_SetRoll (random(0,359))
		LSMK A 0 A_CheckProximity("death","LTPLavaSmoke",50,4)
		LSMK AAAAAAAAAAAA 1 A_Fadeto(1.0,0.1,FTF_CLAMP)
		LSMK AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 4 A_Fadeto(0.0,0.025,FTF_CLAMP|FTF_REMOVE)
		Stop
	death:
		LSMK A 1
		stop
	}
}

