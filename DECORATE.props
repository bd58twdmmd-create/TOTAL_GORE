Actor tennents : CustomInventory
{
  Radius 30
  Height 30
  //scale 0.8
  -SOLID
  +SHOOTABLE
  +NOBLOOD
  +NOGRAVITY
  health 5
  inventory.pickupsound "tennents/pickup"
  Inventory.pickupmessage "TENNENT'S SUPER!"
  
  States
  {
	Spawn:
		TERA A -1
		Stop

	Pickup:
		TNT1 A 0 A_GiveInventory("tennentsarma", 1)
		//TNT1 A 0 A_GiveInventory("tennentsammo", 1)
		TNT1 A 0 A_KillTarget
		Stop
	
	Death:
        TNT1 AAAAA 0 A_SpawnProjectile ("SFXGlassParticle1", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
        TNT1 A 0 A_StartSound("tennents/crash")
        TNT1 A 500
        Stop
  }
}

