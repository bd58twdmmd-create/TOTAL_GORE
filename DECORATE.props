Actor LTPWaterSplashChunk : LTPCoreSplashChunk
{
	
	gravity 0.7
	Alpha 0.4
	stencilcolor "b6b6b6"//HEX color found in gimp color selector in ther HTML notation box.
	+FLATSPRITE
	States
	{
	Spawn:
		TNT1 A 1 A_SetScale(.1,.17)
		TNT1 A 0 A_JumpIf(CallACS("LTPLargeSplash")==0, "Cancel")
		TNT1 A 0 A_JumpIf(CallACS("LTPLargesplashsize")==0, "SpawnMedium")
		KSPH A 0 A_ChangeVelocity(0,0,11)
		KSPH A 0 A_SetPitch (270)
		KSPH A 0 A_Setangle (random(60,110))
		KSPH A 0 A_spawnitemex("Waterripple",0,0,1)
		KSPH A 0 A_spawnitemex("LTPWaterSplashChunk2",0,0,0,0,0,11)
		KSPH A 1 A_SetScale(.11,.18)
		KSPH A 1 A_SetScale(.12,.19)
