		KSPH A 1 A_SetScale(.19,.22)
		KSPH A 1 A_SetScale(.20,.23)
		KSPH A 1 A_SetScale(.21,.24)
		KSPH A 1 A_SetScale(.22,.25)
		KSPH A 1 A_SetScale(.23,.26)
		KSPH A 1 A_SetScale(.24,.27)
		KSPH A 1 A_SetScale(.25,.28)
