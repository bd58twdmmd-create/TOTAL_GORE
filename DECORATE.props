{
    
    +SOLID
	+NOGRAVITY
	+Dropoff
	+ALWAYSPICKUP
	Mass 0x7fffffff //unthrustable
	Radius 20
	Height 20
	States
	{
	Spawn:
		EUR2 A 10
		EUR2 A 1 bright
		loop
		
