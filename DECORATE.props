		KSPH A 0 A_fadeout(0.08)
		KSPH A 2 A_SetScale(.43,.50)
		KSPH A 0 A_fadeout(0.08)
		KSPH A 2 A_SetScale(.44,.51) 
		Stop
		
	SpawnMedium:
		TNT1 A 1 A_SetGravity(0.5)
		KSPH A 0 A_ChangeVelocity(0,0,7.5)
		KSPH A 0 A_SetScale(.05,.08)
		KSPH A 0 A_SetPitch (270)
		KSPH A 0 A_Setangle (random(60,110))
		KSPH A 0 A_spawnitemex("Waterripple",0,0,2)
		KSPH A 0 A_spawnitemex("LTPWaterSplashChunkMed",0,0,-10,0,0,7.5)
		KSPH A 1 A_SetScale(.05,.08)
		KSPH A 1 A_SetScale(.06,.09)
		KSPH A 1 A_SetScale(.07,.10)
		KSPH A 1 A_SetScale(.08,.11)
		KSPH A 1 A_SetScale(.09,.12)
		KSPH A 1 A_SetScale(.10,.13)
		KSPH A 1 A_SetScale(.11,.14)
