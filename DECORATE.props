ACTOR FUOCO_AGOSTO
{
SCALE 2
RENDERSTYLE ADD
+NOCLIP
+BRIGHT
+NOGRAVITY
STATES
{
SPAWN:
TNT1 A 0 A_StartSound("FUOCO",0,CHANF_DEFAULT,TRUE,0.4)
TNT1 A 0 A_SpawnProjectile ("SCINTILLE", 50, random (-25, 25), random (0, 140), 2, random (0, 160))
EX26 ABCDEFGHIJKLMNOPQR 2 A_explode(5,10)
loop
}}

ACTOR FUOCO_AGOSTOGL
{
SCALE 2
RENDERSTYLE ADD
+NOCLIP
+BRIGHT
+NOGRAVITY
STATES
{
SPAWN:
TNT1 A 0 A_StartSound("FUOCO",0,CHANF_DEFAULT,TRUE,0.4)
TNT1 A 0 A_SpawnProjectile ("SCINTILLE", 50, random (-25, 25), random (0, 140), 2, random (0, 160))
//TNT1 A 0 A_SpawnProjectile ("FUMOHELL666SPAWN2", 75, random (-25, 25), random (0, 360), 2, random (80, 90))
EX26 ABCDEFGHIJKLMNOPQR 2 A_explode(5,10)
loop
}

