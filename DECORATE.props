Actor tumor
{
	Radius 1
	Height 1
	-SOLID
	+NOGRAVITY
	+NOCLIP
	+NOBLOCKMAP
	+RELATIVETOFLOOR
	+SLIDESONWALLS
	
	States
	{
		Spawn:
			0000 A 0
			//0000 A 0 A_StartSound("ai/tumoridle", CHAN-AUTO)
		Active:
			0000 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 //bright
			0001 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 //bright
			0002 ABC 1 //bright
			0000 A 0 A_StartSound("ai/tumoridle", CHAN_AUTO)
			loop
		2breath:
			0002 DEFGHIJKLMNOPQRSTUVWXYZ 1 //bright
			0003 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 //bright
			0004 ABCDEF 1 //bright
			0000 A 0 A_StartSound("ai/tumoridle", CHAN_AUTO)
			loop
		1breath:
			0004 GHIJKLMNOPQRSTUVWXYZ 1 //bright
			0005 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 //bright
			0006 ABCDEFGHI 1 //bright
			0000 A 0 A_StartSound("ai/tumoridle", CHAN_AUTO)
			loop
		3to2:
			0006 JKLMNOPQRSTUVWXYZ 1 A_Quake(2, 2, 0, 5120, "")
			0007 ABCDEFGHIJK 1 
			goto 2breath
		2to1:
			0007 LMNOPQRSTUVWXYZ 1 A_Quake(2, 2, 0, 5120, "")
			0008 ABCDEFGHIJKLM 1 
			goto 1breath
		Die:
			AITE A 0
			AITE A 0 A_StopSound(CHAN_BODY)
			0008 NOPQRSTUVWXYZ 1 A_Quake(2, 2, 0, 5120, "")
			0009 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
			0010 ABCDEFG 1
			0010 G 10
			0010 G -1
			stop
	}
}

