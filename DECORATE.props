Actor VANUMBRIAJAZZSBIRR {
			
		Health	8000
    Gravity 0.7
	Mass	99999999
scale 1.7
  PainChance 0
  Speed 30
  MeleeRange 200
  Monster
  +NOBLOOD
  +NOSPLASHALERT
  +ALWAYSRESPAWN
  +NOTARGETSWITCH
  -CANUSEWALLS
  +DROPOFF
  //seesound "sirena"
  Deathsound "weapons/rocklx"
  //ActiveSound "sirena"
  //Obituary "%o was ran down by a cop car."
  States
  {
  Spawn:
    COPF A 0 A_StopSound
    COPF A 10 A_LookEx(LOF_NOSIGHTCHECK, 0, 1024, 1024, 30)
  Spawn2:
    COPF A 10 A_LookEx(LOF_NOSIGHTCHECK, 0, 1024, 1024, 30)
    Loop
  See:
    COPF AA 1 A_Chase
    COPF AA 1 bright A_Chase
    COPF A 0 //A_LoopActiveSound
    COPF AA 1 A_Chase
    COPF AA 1 bright A_Chase
    COPF A 0 A_GiveToTarget("WantedStar1", 1) 
  See2:
    TNT1 A 0 A_JumpIfHealthLower(1000,"Smoke")
    COPF AA 1 A_Chase
    COPF AA 1 bright A_Chase
    TNT1 A 0 A_JumpIfHealthLower(1000,"Smoke2")
    COPF AA 1 A_Chase
    COPF AA 1 bright A_Chase
    //COPA CC 1 bright Light("COPREDLITE") A_Chase
    Loop
  Pain:
    COPF A 20
    Goto See2
  Melee:
    COPF A 0 A_Jump(128,2)
    COPF A 10 A_CustomMeleeAttack(random(1,2)*18)
    Goto See2
    COPF A 10 A_Die
    Loop
  Death:
    COPF B 1 A_Fall
    COPF B 0 A_StopSound
	tnt1 a 0 A_StartSound("EXPLOSIONA", CHAN_AUTO|CHANF_OVERLAP)
		TNT1 A 0 A_SpawnProjectile ("BOOMONEDIOCANONE", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 Radius_Quake (22, 10, 0, 128, 0)
	    TNT1 A 0 A_CustomMissile ("BOOMDIOCANE", 50, 0, random (0, 360), 2, random (30, 120))
        //TNT1 AAAAAAAA 0 A_SpawnProjectile ("ExplosionSmoke", 22, 0, random (0, 360), 2, random (0, 360))
		//TNT1 A 0 A_SpawnItemEx("BeefShockBoomSpawner",0,0,20,0,0,0,0,SXF_TRANSFERPOINTERS)
		//TNT1 AAAAAA 0 //A_Explode(100, 100)
		TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnProjectile ("ShrapnelParticleGREZZO2", 0, 0, random (0, 360), 2, random (0, 360))
        TNT1 AAA 0 A_SpawnProjectile ("ExplosionQuakeSTRONG", 1, 0, random (0, 360), 2, random (0, 160))
        TNT1 A 0 A_StartSound("FAREXPL")
		
        TNT1 AA 0 A_SpawnProjectile ("SFXGlassParticle1", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
        TNT1 AA 0 A_SpawnProjectile ("SFXGlassParticle2", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
        TNT1 AA 0 A_SpawnProjectile ("SFXGlassParticle3", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
        TNT1 AA 0 A_SpawnProjectile ("SFXGlassParticle4", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
        TNT1 A 0 A_StartSound("GLSFAL")

		TNT1 AAAAAAAAAA 0 Bright A_Explode(20,128)
	
		//TNT1 A 10 //A_explode(100,50)
		
        TNT1 AAA 0 A_SpawnProjectile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAA 0 A_SpawnProjectile ("ExplosionSmokeFast22", 2, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAAAAAAA 0 A_SpawnProjectile ("ExplosionSmokeFast22", 2, 0, random (0, 360), 2, random (0, 360))
    COPF B 4 bright A_Playsound("CARENTR") 
    COPF B 0 A_SpawnItemEx("pretespawner",0,-40,0,0,0,0,0,0)//,SXF_TRANSFERPOINTERS)
    COPF B 0 A_SpawnItemEx("mommi",0,-40,0,0,0,0,0,64)
	//COPF B 0 A_SpawnItemEx("mettswat",0,40,0,0,0,0,0,0,128)
    //COPF B 0 A_SpawnItemEx("CopCarDrive",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    TNT1 A 4 A_Playsound("CAREXIT")
    COPF B -1
    Stop
	
	Smoke:
    	TNT1 AAA 0 A_SpawnProjectile ("BigBlackSmokePillarDIO2", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAA 0 A_SpawnProjectile ("BigBlackSmokePillarDIO2", 2, 0, random (0, 360), 2, random (0, 360))
		//TNT1 AAAAAAAAAAAAAA 0 A_SpawnProjectile ("ExplosionSmokeFast22", 2, 0, random (0, 360), 2, random (0, 360))
    goto See2+1
  Smoke2:
    	TNT1 AAA 0 A_SpawnProjectile ("BigBlackSmokePillarDIO2", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAA 0 A_SpawnProjectile ("BigBlackSmokePillarDIO2", 2, 0, random (0, 360), 2, random (0, 360))
		//TNT1 AAAAAAAAAAAAAA 0 A_SpawnProjectile ("ExplosionSmokeFast22", 2, 0, random (0, 360), 2, random (0, 360))
    goto See2+6
  
  /*Smoke:
    TNT1 A 0 A_SpawnItemEx("FUMOHELL666",64,0,8,0,0,2,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    goto See2+1
  Smoke2:
    TNT1 A 0 A_SpawnItemEx("FUMOHELL666",64,0,8,0,0,2,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    goto See2+6
	*/
	
	
  }
}

