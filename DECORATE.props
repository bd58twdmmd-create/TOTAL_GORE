////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////core///////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
//Core Splash definition for others to inherit from

ACTOR LTPCoreSplashChunk
{
	Radius 2
	Height 1
	SCALE 0.5
	renderstyle shaded// treats black on the texture as transparent and white as full opacity
	+NOBLOCKMAP 
	+DROPOFF
	+NOTELEPORT
	+LOWGRAVITY
	+CANNOTPUSH
	+DONTSPLASH
	+DONTBLAST
	+NOCLIP
}

ACTOR LTPCoreSplashBase
{
	Radius 2
	Height 1	
	SCALE 0.5
	renderstyle shaded// treats black on the texture as transparent and white as full opacity
	+NOBLOCKMAP
	+NOCLIP
	+NOGRAVITY
	+DONTSPLASH
	+DONTBLAST
	+FORCEYBILLBOARD
}


ACTOR LiquidRipple
{
	Radius 4
	Height 1	
	SCALE 0.1
	renderstyle shaded// treats black on the texture as transparent and white as full opacity
	+FLATSPRITE
	+NOBLOCKMAP
	+NOCLIP
	+NOGRAVITY
	+DONTSPLASH
	+DONTBLAST
}

////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////Lava/////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

ACTOR LTPLavaChunk :LTPCoreSplashChunk
{
	gravity 0.7
	renderstyle AddShaded // treats black on the texture as transparent and white as full opacity
	Alpha 1.0
	stencilcolor "fd7900"//HEX color found in gimp color selector in ther HTML notation box.
	+FLATSPRITE
	States
{
	Spawn:
		TNT1 A 1 Bright A_SetScale(.1,.17)
		TNT1 A 0 A_JumpIf(CallACS("LTPLargeSplash")==0, "Cancel")
		TNT1 A 0 A_JumpIf(CallACS("LTPLargesplashsize")==0, "SpawnMedium")
		KSPH A 0 A_ChangeVelocity(0,0,11)
		SPHA A 0 A_SetPitch (270)
		SPHA A 0 A_Setangle (random(60,120))
		SPHA A 0 A_spawnitemex("LTPLavaChunk2",0,0,0,0,0,11)
		SPHA A 0 A_spawnitemex("LTPLavaSmoke",0,0,0,0,0,1)
		SPHA A 1 Bright A_SetScale(.11,.18)
		SPHA A 1 Bright A_SetScale(.12,.19)
		SPHA A 1 Bright A_SetScale(.13,.20)
		SPHA A 1 Bright A_SetScale(.14,.21)
		SPHA A 1 Bright A_SetScale(.15,.22)
		SPHA A 1 Bright A_SetScale(.16,.23)
		SPHA A 1 Bright A_SetScale(.17,.24)
		SPHA A 1 Bright A_SetScale(.18,.25)
		SPHA A 1 Bright A_SetScale(.19,.26)
		SPHA A 1 Bright A_SetScale(.20,.27)
		SPHA A 1 Bright A_SetScale(.21,.28)
		SPHA A 1 Bright A_SetScale(.22,.29)
		SPHA A 1 Bright A_SetScale(.23,.30)
		SPHA A 1 Bright A_SetScale(.24,.31)
		SPHA A 1 Bright A_SetScale(.25,.32)
		SPHA A 1 Bright A_SetScale(.26,.33)
		SPHA A 1 Bright A_SetScale(.27,.34)
		SPHA A 1 Bright A_SetScale(.28,.35)
		SPHA A 1 Bright A_SetScale(.29,.36)
		SPHA A 1 Bright A_SetScale(.30,.37)
		SPHA A 1 Bright A_SetScale(.31,.38)
		SPHA A 1 Bright A_SetScale(.32,.39)
		SPHA A 1 Bright A_SetScale(.33,.40)
		SPHA A 1 Bright A_SetScale(.34,.41)
		SPHA A 1 Bright A_SetScale(.35,.42)
