		TNT1 A 0 A_GiveInventory ("zaino1",10,0)
		
		Stop
	

  }
}



ACTOR puttobomb : tennents
{
health 500
	speed 40//20
	damage 25
	seesound "MiniRocket/Fly"
	deathsound "RLBOOM"
	Decal scorchone
	PROJECTILE
	-NOGRAVITY
    +dontsplash
	+NOEXTREMEDEATH
	//mass 9000
	gravity 8
scale 0.15

	States 
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetPitch(pitch+180)
			BOMB AAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 BRIGHT A_SetPitch(pitch+35)
			Wait
			
			DEATH:
			TNT1 A 0
			TNT1 A 0 A_jump(75,"death2")
			TNT1 A 0 A_explode(1,250)
			TNT1 A 0 A_spawnitem("boomdiocane")
			stop
			
						DEATH2:
			TNT1 A 0
			TNT1 A 0 A_explode(1,250)
			TNT1 A 0 A_spawnitem("boomonediocanone")
			stop
			
	}
}

