		RKEX A 1 bright A_Explode (450,150)
		TNT1 A 0 A_AlertMonsters
    Blast:
        TNT1 AAAAAAAAAAAAAA 0 A_SpawnProjectile("OldschoolRocketSmokeTrail2",22,0,(random(0,360)),CMF_AIMDIRECTION)
		TNT1 AAAAAAAAA 0 A_SpawnProjectile("DCExplosionSmall",22,0,(random(0,360)),CMF_AIMDIRECTION)
    EndBoom:
        RKEX BCDEFGHIJKLMNOPQRSTU 2 bright
        Stop
	}
}


