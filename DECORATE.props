Actor FuocoFINAL 
{ 
  //Health 200
  //mass 9999
  Radius 20
  Height 20
  scale 1//scale 0.9
  //monster
  +DONTSPLASH
  -SOLID
  +SPECTRAL
  +NOTARGET
  +NOGRAVITY
  
  
  States
  {
  Spawn:
    //TNT1 A 0 A_Explode (3,50)
    TNT1 A 0 A_JumpIf(waterlevel == 2, "DeepWater")
	TNT1 A 0 A_Playsound ("FUOCO", CHAN_AUTO, 0.5, TRUE, ATTN_NORM)
	F1R3 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 bright A_Explode(3,50)
	TNT1 A 0 A_Explode (3,50)
	F1R3 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 bright A_Explode(3,50)
	//TNT1 A 0 A_spawnitem("BigBlackSmokePillarDIO_Spawn", 84, frandom(1.2, 1.8))
	//TNT1 A 0 A_Spawnitem("BigBlackSmokePillarDIO2", 0)
	//TNT1 A 0 A_Explode ( 5, 50 )
	loop
	
	DeepWater:
	stop	
	
	}
}

Actor FuocoFINAL_noculling : FUOCOFINAL
{ 

}

