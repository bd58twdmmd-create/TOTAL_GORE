ACTOR PALLA
{
    Radius 40
    Height 40
    //Scale 0.5
	Speed 9
	Mass 1
    gravity 0.4
	health 99999999
	BounceFactor 0.6
	painchance 255
	+DOOMBOUNCE
    +MOVEWITHSECTOR
    +CLIENTSIDEONLY
    +NOBLOCKMAP
    +NOTELEPORT
    +MISSILE
	+pushable
	+shootable
	+SOLID
	//PROJECTILE
	monster
	
    States
    {
	
    Spawn:
	 TERA A 1
		Loop
		
		pain:
					TNT1 A 0 A_SetPitch(pitch+180)
					TNT1 A 0 ThrustThingZ(0,random(5,10),0,1)
			TERA AAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SetPitch(pitch+35)
			goto spawn
		
		DEATH:
	 TERA A 1
		Loop
		
    }
}


