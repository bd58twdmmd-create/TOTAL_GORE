	+THRUActorS
	+WINDTHRUST
	+CLIENTSIDEONLY
    SeeSound "misc/xdeath4"
    DeathSound "misc/xdeath3"
	decal merdadecal
    States
    {
    Spawn:
	    TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
        POO2 AAAAA 1 A_SpawnItemEx("splatterini", 0, 0, 0, 0, 0, 0, random (0, 360), SXF_TRANSFERTRANSLATION, 208)
		POO2 BBBBB 1 A_SpawnItemEx("splatterini", 0, 0, 0, 0, 0, 0, random (0, 360), SXF_TRANSFERTRANSLATION, 208)
		POO2 CCCCC 1 A_SpawnItemEx("splatterini", 0, 0, 0, 0, 0, 0, random (0, 360), SXF_TRANSFERTRANSLATION, 208)
		POO2 DDDDD 1 A_SpawnItemEx("splatterini", 0, 0, 0, 0, 0, 0, random (0, 360), SXF_TRANSFERTRANSLATION, 208)
        Loop
		
    Death:
	TNT1 A 0 A_jump(127,"Death2")
        //TNT1 AAAAAAA 0 A_SpawnProjectile ("NashGore_FlyingBloodTrail5", 0, 0, random (0, 180), 2, random (0, 180))
        //TNT1 A 0 A_SpawnItem("NashGore_BloodSpot",0,0,0,1)
		TNT1 A 0 A_StartSound("flesh/land")
		TNT1 A 0 A_SpawnItem("merdasplat2",0,0,0,1)
		TNT1 A 0 A_SpawnItem("merdaspawner2",0,0,0,1)
        //POO2 E 444 A_SetScale(0.02)
		//TNT1 A 0 A_setscale(0.5)
		//TNT1 A 0 A_StartSound("misc/xdeath1")
        Stop
		
		Death2:
		        //TNT1 AAAAAAA 0 A_SpawnProjectile ("NashGore_FlyingBloodTrail5", 0, 0, random (0, 180), 2, random (0, 180))
        //TNT1 A 0 A_SpawnItem("NashGore_BloodSpot",0,0,0,1)
		TNT1 A 0 A_StartSound("flesh/land")
		TNT1 A 0 A_SpawnItem("merdasplat2",0,0,0,1)
		TNT1 A 0 A_SpawnItem("merdaspawner2",0,0,0,1)
        //POO2 E 444 A_SetScale(0.02)
		//TNT1 A 0 A_setscale(0.5)
		//TNT1 A 0 A_StartSound("misc/xdeath1")
        Stop
		
    Splash:
        TNT1 A 1
		POO2 E 444 //A_SetScale(0.02)
		TNT1 A 0 A_setscale(0.5)
		TNT1 A 0 A_StartSound("misc/xdeath1")
        Stop
    }
}

Actor splatterini
{

  Radius 4
  Height 4
  Speed 0
  Projectile
  -NOGRAVITY
  -NOBLOCKMAP
  +THRUGHOST
  Gravity 0.5
  scale 0.150//0.125

  var int user_newblood;

  States
  {
  Spawn:

    TNT1 A 0 NoDelay A_SetScale(random (22, 35)/100.0, random (22, 35)/100.0)//A_SetScale(random (12, 25)/100.0, random (12, 25)/100.0)
    TNT1 A 0 A_Jump(256,"newblood1s","newblood2s","newblood3s","newblood4s")

    newblood1s:
	TNT1 A 0 A_setUserVar("user_newblood",1)
	goto spawn1
    newblood2s:
	TNT1 A 0 A_setUserVar("user_newblood",2)
	goto spawn2
    newblood3s:
	TNT1 A 0 A_setUserVar("user_newblood",3)
	goto spawn3
    newblood4s:
	TNT1 A 0 A_setUserVar("user_newblood",4)
	goto spawn4

    spawn1:
	SBL1 E 5
	loop
    spawn2:
	SBL2 E 5
	loop
    spawn3:
	SBL3 E 5
	loop
    spawn4:
	SBL4 E 5
	loop

    stop

  Death:

    TNT1 A 0 A_ChangeFlag("FLATSPRITE", 1)
    TNT1 A 0 A_SetScale(random (22, 35)/100.0)//A_SetScale(random (12, 25)/100.0)

    TNT1 A 0 A_Jump(128,2)
    TNT1 A 0 A_ChangeFlag("SPRITEFLIP", 1)
    TNT1 A 0

    TNT1 A 0 A_JumpIf(user_newblood==1,"newblood1d")
    TNT1 A 0
    TNT1 A 0 A_JumpIf(user_newblood==2,"newblood2d")
    TNT1 A 0
    TNT1 A 0 A_JumpIf(user_newblood==3,"newblood3d")
    TNT1 A 0
    TNT1 A 0 A_JumpIf(user_newblood==4,"newblood4d")
    TNT1 A 0
    stop

    newblood1d:
    	SBL1 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 35 A_Gravity
	SBL1 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 A_FadeOut(0.1)
	stop
    newblood2d:
    	SBL2 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 35 A_Gravity
	SBL2 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 A_FadeOut(0.1)
	stop
    newblood3d:
    	SBL3 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 35 A_Gravity
	SBL3 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 A_FadeOut(0.1)
	stop
    newblood4d:
    	SBL4 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 35 A_Gravity
	SBL4 EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 A_FadeOut(0.1)
    stop

  }
}

