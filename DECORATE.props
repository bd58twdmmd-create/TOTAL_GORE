Actor uovotreddi
{
  health 100
  Scale 100
 
  Radius 50
  Height 120
  mass 99999
  //scale 0.25
  +SOLID
  +NOGRAVITY
  +SHOOTABLE
  States
  {
  Spawn:
    TERA A 1
    loop
	
	death:
       TNT1 AAAA 0 A_SpawnProjectile ("CeilBloodLauncherLong", 0, 0, random (0, 360), 2, random (50, 130))
	   TNT1 A 0 A_StartSound ("misc/xdeath4",chan_auto)
       TNT1 A 0 A_SPAWNITEMEX("GIBSPAWNER",0,0,0,RANDOM(0,0),RANDOM(0,0),0)
	   TNT1 A 0 A_Jump (180,"minigesuspawn","gesuspawn")
	   TNT1 A 0 A_ThrowGrenade("minisuora_ragno",90,15,5,0)
	    TNT1 A 1 A_Scream
		TNT1 A 0 A_SpawnItem ("pozzadesangue")
		stop
		
		minigesuspawn:
		  TNT1 A 0 A_ThrowGrenade("miniminigesumosca",90,15,5,0)
		  goto die
		  
		  		gesuspawn:
		  TNT1 A 0 A_ThrowGrenade("minigesumosca",90,15,5,0)
		  goto die
		  
		  die:
		  TNT1 A 0
		  stop
  }
}

