ACTOR tv_united : switchabledecoration
{
  //$Category industrial
  Height 50
  radius 40
  health 200
  //monster
  //speed 0
  scale 5
  +SOLID
  +NOGRAVITY
  +SHOOTABLE
  +NOBLOOD 
  
  States
  {
  Spawn:
    TERA A 1
	loop
	
	active:
	TERA B 100
	goto tg
	
	tg:
	TERA C 3000
	goto noise
	
	noise:
	
	TERA B 1
	loop
	
  death:
    TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx ("RicoChet",0,0,-5,0,0,0,0,SXF_NOCHECKPOSITION,0)//A_SpawnProjectile ("ExplosionParticleHeavy", 0, 0, random (0, 180), 2, random (0, 180))
	TNT1 AAAAA 0 A_SpawnProjectile ("SFXGlassParticle1", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
	TNT1 A 0 A_spawnitem("BOOMDIOCANE")
			TNT1 AAAAA 0 A_SpawnProjectile ("SFXGlassParticle2", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
			TNT1 AAAAA 0 A_SpawnProjectile ("SFXGlassParticle3", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
			TNT1 AAAAA 0 A_SpawnProjectile ("SFXGlassParticle4", random (0, 40), random (-20, 20), random (0, 360), 2, random (30, 60))
			TNT1 A 0 A_StartSound("GLSFAL")
	TERA D -1
	loop
	
  }
}

Actor tv_karaoke : tv_united {
	  States
  {
  Spawn:
    TERA C -1
	Loop
	
  }
}

