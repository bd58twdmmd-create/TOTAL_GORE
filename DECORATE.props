Actor MACHINA1
{   
	radius 50
	height 50
	mass 9999
	health 500
	damagefActor "ExplosiveImpact", 5.0
	+SOLID
	+SHOOTABLE
	+NOBLOOD
	+ACTIVATEMCROSS
	+DONTGIB
	+NOICEDEATH
	+OLDRADIUSDMG

	States
 	{
		Spawn:
			WTFD A -1
			Loop

 		Death:
			TNT1 A 0 A_NoBlocking
			TNT1 A 0 A_Fall
			TNT1 A 0 {
				A_SpawnItemEx ("RocketExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_StopSound(CHAN_BODY);
				A_StartSound("FAREXPL", CHAN_AUTO|CHANF_OVERLAP);
				Radius_Quake (18, 40, 0, 256, 0);
				A_SpawnItem("cratersplat",0,0,0,1);
				A_StartSound("BeefSupreme/Explode",5);
				A_SpawnProjectile("ExplosionQuake", 0, 0, 0, 0);
				A_SpawnProjectile("RicoChet");
				A_SpawnItem ("RicoChet", 0, -30);
				A_SpawnItemEx ("ExplosionFlareSpawner2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_SpawnItemEx("NewRocketExploFX", 0, 0, 0);
				A_SpawnProjectile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360));
				A_SpawnProjectile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360));
				A_SpawnProjectile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360));
				A_SpawnProjectile ("PBExplosionparticles", 0, 0, random (0, 360), 2, random (40, 90));
				A_SpawnProjectile ("PBExplosionparticles", 0, 0, random (0, 360), 2, random (40, 90));
				A_SpawnProjectile ("PBExplosionparticles2", 0, 0, random (0, 360), 2, random (40, 90));
				A_SpawnProjectile ("PBExplosionparticles2", 0, 0, random (0, 360), 2, random (40, 90));
				A_SpawnProjectile ("PBExplosionparticles3", 10, 0, random (0, 360), 2, random (40, 90));
				A_SpawnItemEx("BeefExploder",0,0,0,0,0,0,0,SXF_CLIENTSIDE); 
				A_Explode(20,128);
				A_SpawnItemEx("BeefShockBoomSpawner",0,0,20,0,0,0,0,SXF_TRANSFERPOINTERS);
			}
			INTC A 3 Bright
			INTC B 3 Bright A_Scream
			INTC C 3 Bright
			INTC B 3 Bright A_Explode
			INTC A 3 Bright 
			INTC A -1
			TNT1 AAAAA 100 A_SpawnProjectile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (50, 130))
	}
}

