actor fungoatomicocinino
{
	Renderstyle Add
	Speed 1
	+NOTELEPORT
	+FORCEXYBILLBOARD
	+NOTIMEFREEZE
	+NOGRAVITY
	+NOBLOCKMAP
	+Puffonactors
	-NOCLIP
	States
	{
