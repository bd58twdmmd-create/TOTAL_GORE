Actor capanna
{
	Radius 200
	Height 150
	Health 35000
	//scale 0.25
	+SOLID
	+SHOOTABLE
	+NOBLOOD
	-PUSHABLE
	+DONTRIP
	mass 999999999999
	

	States
	{
		Spawn:
			TERA A 1
			loop
	
		Death:
		//TNT1 A 0 nodelay
		   	TNT1 A 0 A_StartSound("Weapons/StalinowiczBoom",0)
  			TNT1 A 0 A_StartSound("Weapons/MegaNukeExp", 5, 1.0, 0, ATTN_NONE)
			TERA AAA 20 {
				Radius_Quake (22, 140, 0, 64, 0);
				A_SpawnItemEx ("BOOMONEDIOCANONE",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_spawnitem("BrokenWindowSpawn", random(10,20),random(100,200),0,0);
				A_Explode(1,200);
				A_SpawnProjectile ("ShrapnelParticleGREZZO2", 0, 0, random (0, 360), 2, random (0, 360));
				Radius_Quake (200, 20, 0, 256, 0);
				A_SpawnItemEx ("ExplosionFlareSpawner2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_SpawnItemEx("BeefShockBoomSpawner",0,0,20,0,0,0,0,SXF_TRANSFERPOINTERS);
			}
			TNT1 A 0 A_SpawnItemEx("NewBExploderCAPANNA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
			TNT1 AA 0 A_spawnitem("BrokenWindowSpawn", random(10,20),random(100,200),0,0)
			//TNT1 AAA 10 
			goto MACERIE
		
		MACERIE:
			//TERA B 25 A_SpawnProjectile ("FOCONE", 0, 0, random (40, 180), 2, random (60, 120))
			TERA B 25 A_SpawnProjectile ("BigBlackSmokePillarDIO2", random(300,400), 0, random (40, 180), 2, random (60, 120))
			wait
	}
}

